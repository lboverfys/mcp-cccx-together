{
  "name": "cc-team-mcp",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Cross-platform MCP server for Codex to coordinate local Claude Code workers",
  "bin": { "cc-team-mcp": "src/cli.mjs" },
  "files": ["src/", "README.md", "README.zh-CN.md", "team.config.example.json"],
  "repository": { "type": "git", "url": "git+https://github.com/lboverfys/mcp-cccx-together.git" },
  "bugs": { "url": "https://github.com/lboverfys/mcp-cccx-together/issues" },
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/cli.mjs",
    "doctor": "node src/cli.mjs doctor",
    "setup": "node src/cli.mjs setup",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
